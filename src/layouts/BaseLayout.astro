---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  active?: string;
  language?: "ru" | "en" | "kz";
}

const {
  title = 'Utilix — бесплатные онлайн-инструменты',
  description = 'Полезные онлайн-инструменты для работы, учёбы и повседневных задач.',
  active = '',
  language = "ru",
} = Astro.props;

const pathname = Astro.url.pathname.replace(/^\/(?:en|kz)(?=\/|$)/, "") || "/";
const localizedHref = (locale: "ru" | "en" | "kz") =>
  locale === "ru" ? pathname : `/${locale}${pathname}`;
const localeHome = language === "ru" ? "/" : `/${language}/`;
const languageNames = { ru: "Язык", en: "Language", kz: "Тіл" };

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : undefined;
---
<!doctype html>
<html lang={language === "kz" ? "kk-KZ" : language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f7fb" />

    <meta name="description" content={description} />
    <title>{title}</title>

    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <meta property="og:locale" content={language === "kz" ? "kk_KZ" : language === "en" ? "en_US" : "ru_RU"} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Utilix" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/png" sizes="200x200" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={localeHome} aria-label={language === "en" ? "Utilix — home" : language === "kz" ? "Utilix — басты бет" : "Utilix — главная"}><img class="brand-mark" src="/favicon.png" alt="" /><span>utilix</span></a>
        <nav aria-label={language === "en" ? "Main navigation" : language === "kz" ? "Негізгі навигация" : "Основная навигация"}>
          <a href={`${localeHome}#categories`} class:list={{active: active === 'categories'}}>{language === "en" ? "Categories" : language === "kz" ? "Санаттар" : "Категории"}</a>
          <a href={language === "en" ? "/en/about/" : language === "kz" ? "/kz/about/" : "/about/"}>{language === "en" ? "About" : language === "kz" ? "Жоба туралы" : "О проекте"}</a>
        </nav>
        <div class="language-switcher" aria-label={languageNames[language]}>
          <a href={localizedHref("ru")} lang="ru" aria-current={language === "ru" ? "page" : undefined}>RU</a>
          <a href={localizedHref("en")} lang="en" aria-current={language === "en" ? "page" : undefined}>EN</a>
          <a href={localizedHref("kz")} lang="kk-KZ" aria-current={language === "kz" ? "page" : undefined}>KZ</a>
        </div>
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label={language === "en" ? "Toggle theme" : language === "kz" ? "Тақырыпты ауыстыру" : "Переключить тему"}>◐</button>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <a class="brand footer-brand" href={localeHome} aria-label={language === "en" ? "Utilix — home" : language === "kz" ? "Utilix — басты бет" : "Utilix — главная"}><img class="brand-mark" src="/favicon.png" alt="" /><span>utilix</span></a>
        <p>{language === "en" ? "Useful tools. Nothing extra." : language === "kz" ? "Пайдалы құралдар. Артық ештеңе жоқ." : "Полезные инструменты. Ничего лишнего."}</p>
        <div class="footer-links"><a href={language === "en" ? "/en/about/" : language === "kz" ? "/kz/about/" : "/about/"}>{language === "en" ? "About" : language === "kz" ? "Жоба туралы" : "О проекте"}</a><a href={language === "en" ? "/en/privacy/" : language === "kz" ? "/kz/privacy/" : "/privacy/"}>{language === "en" ? "Privacy" : language === "kz" ? "Құпиялылық" : "Конфиденциальность"}</a></div>
        <small>© {new Date().getFullYear()} Utilix</small>
      </div>
    </footer>
    <script>
      const root = document.documentElement;
      const saved = localStorage.getItem('utilix-theme');
      const preferred = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      root.dataset.theme = saved || preferred;
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        localStorage.setItem('utilix-theme', next);
      });
    </script>
  </body>
</html>

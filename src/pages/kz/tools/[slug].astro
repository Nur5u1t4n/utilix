---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ToolCard from '../../../components/ToolCard.astro';
import ToolRunner from '../../../components/ToolRunner.astro';
import { kazakhTools } from '../../../data/kazakh';
export function getStaticPaths() { return kazakhTools.map(tool => ({ params: { slug: tool.slug }, props: { tool } })); }
const { tool } = Astro.props;
const related = kazakhTools.filter(item => item.category === tool.category && item.slug !== tool.slug).slice(0, 3);
---
<BaseLayout language="kz" title={`${tool.title} — Utilix`} description={tool.description}>
  <section class="tool-page container"><a class="breadcrumb" href="/kz/">Басты бет</a><span class="breadcrumb-sep">/</span><a class="breadcrumb" href={`/kz/category/${tool.category}/`}>{tool.categoryTitle}</a>
    <div class="tool-page-heading"><span class="tool-icon large">{tool.icon}</span><div><span class="eyebrow">{tool.categoryTitle.toLocaleUpperCase('kk-KZ')}</span><h1>{tool.title}</h1><p>{tool.description}</p></div></div>
    <ToolRunner tool={tool} language="kz" />
    <article class="content-panel"><h2>Құрал туралы</h2><p>{tool.intro}</p><h3>Қолдану жолы</h3><ol>{tool.howTo.map(step => <li>{step}</li>)}</ol><h3>Мысал</h3><p>{tool.example}</p><p class="privacy-note">Бұл құрал деректеріңізді браузерде өңдейді және серверге жібермейді.</p></article>
    {related.length > 0 && <section class="related"><h2>Ұқсас құралдар</h2><div class="tool-grid">{related.map(item => <ToolCard tool={item} />)}</div></section>}
  </section>
</BaseLayout>

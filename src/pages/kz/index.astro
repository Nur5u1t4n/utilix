---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import { kazakhTools, kazakhCategories } from '../../data/kazakh';
const popular = kazakhTools.slice(0, 6);
---
<BaseLayout language="kz" title="Utilix — тегін онлайн құралдар" description="Есептеуге, түрлендіруге және мәтін мен деректерді өңдеуге арналған тегін онлайн құралдар. Тіркелусіз, браузерде қолданыңыз.">
  <section class="hero"><div class="container hero-inner"><span class="eyebrow"><span class="eyebrow-dot"></span>ТЕГІН ОНЛАЙН ҚҰРАЛДАР</span><h1>Тегін онлайн құралдар.<br /><span>Оңай. Жылдам. Тіркелусіз.</span></h1><p>Жұмысқа, оқуға және күнделікті тірлікке арналған пайдалы құралдар.</p><label class="search-box"><span aria-hidden="true">⌕</span><input id="tool-search" type="search" placeholder="Құралды іздеу..." autocomplete="off" /><kbd>Іздеу</kbd></label><div id="search-results" class="tool-grid" hidden></div><p class="empty-state" id="no-results" hidden>Ештеңе табылмады. Басқа сұрауды енгізіңіз.</p><div class="hero-meta"><span>✦ Тегін</span><span>↗ Браузерде жұмыс істейді</span><span>◉ Тіркелу қажет емес</span></div></div></section>
  <section class="section container" id="popular"><div class="section-heading"><div><span class="eyebrow">БАСТАУ</span><h2>Танымал құралдар</h2></div><a class="text-link" href="#all-tools">Барлық құралдар ↗</a></div><div class="tool-grid" id="popular-tools-grid">{popular.map(tool => <ToolCard tool={tool} />)}</div></section>
  <section class="section categories-section" id="categories"><div class="container"><div class="section-heading"><div><span class="eyebrow">КІТАПХАНА</span><h2>Құрал санаттары</h2></div></div><div class="category-grid">{kazakhCategories.map((category, i) => <a class="category-card" href={`/kz/category/${category.slug}/`}><span class="category-number">0{i + 1}</span><h3>{category.title}</h3><p>{category.description}</p><span class="category-link">Санатты ашу ↗</span></a>)}</div></div></section>
  <section class="section container" id="all-tools"><div class="section-heading"><div><span class="eyebrow">ТОЛЫҚ КІТАПХАНА</span><h2>Барлық құрал</h2></div><span class="count-pill">{kazakhTools.length} құрал</span></div><div class="tool-grid all-tools-grid">{kazakhTools.map(tool => <ToolCard tool={tool} />)}</div></section>
  <script>
    const input = document.querySelector<HTMLInputElement>('#tool-search');
    const allToolsGrid = document.querySelector<HTMLElement>('.all-tools-grid');
    const cards = allToolsGrid ? [...allToolsGrid.querySelectorAll<HTMLElement>('.tool-card')] : [];
    const searchResults = document.querySelector<HTMLElement>('#search-results');
    const noResults = document.querySelector<HTMLElement>('#no-results');
    const sections = ['#popular', '#categories', '#all-tools'].map((selector) => document.querySelector<HTMLElement>(selector));
    input?.addEventListener('input', () => {
      const query = input.value.trim().toLocaleLowerCase('kk-KZ');
      if (!query) {
        cards.forEach((card) => { card.hidden = false; allToolsGrid?.append(card); });
        if (searchResults) searchResults.hidden = true;
        if (noResults) noResults.hidden = true;
        sections.forEach((section) => { if (section) section.hidden = false; });
        return;
      }
      sections.forEach((section) => { if (section) section.hidden = true; });
      if (searchResults) searchResults.hidden = false;
      let matchCount = 0;
      cards.forEach((card) => {
        const matches = (card.dataset.search ?? card.innerText).toLocaleLowerCase('kk-KZ').includes(query);
        card.hidden = !matches;
        if (matches) { matchCount++; searchResults?.append(card); } else allToolsGrid?.append(card);
      });
      if (noResults) noResults.hidden = matchCount > 0;
    });
  </script>
</BaseLayout>

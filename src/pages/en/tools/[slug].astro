---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ToolCard from '../../../components/ToolCard.astro';
import ToolRunner from '../../../components/ToolRunner.astro';
import { englishTools } from '../../../data/english';
export function getStaticPaths() { return englishTools.map(tool => ({ params: { slug: tool.slug }, props: { tool } })); }
const { tool } = Astro.props;
const related = englishTools.filter(item => item.category === tool.category && item.slug !== tool.slug).slice(0, 3);
---
<BaseLayout language="en" title={`${tool.title} — Utilix`} description={tool.description}>
  <section class="tool-page container"><a class="breadcrumb" href="/en/">Home</a><span class="breadcrumb-sep">/</span><a class="breadcrumb" href={`/en/category/${tool.category}/`}>{tool.categoryTitle}</a>
    <div class="tool-page-heading"><span class="tool-icon large">{tool.icon}</span><div><span class="eyebrow">{tool.categoryTitle.toUpperCase()}</span><h1>{tool.title}</h1><p>{tool.description}</p></div></div>
    <ToolRunner tool={tool} language="en" />
    <article class="content-panel"><h2>About this tool</h2><p>{tool.intro}</p><h3>How to use it</h3><ol>{tool.howTo.map(step => <li>{step}</li>)}</ol><h3>Example</h3><p>{tool.example}</p><p class="privacy-note">This tool processes your input in your browser. It does not send your data to a server.</p></article>
    {related.length > 0 && <section class="related"><h2>Related tools</h2><div class="tool-grid">{related.map(item => <ToolCard tool={item} />)}</div></section>}
  </section>
</BaseLayout>

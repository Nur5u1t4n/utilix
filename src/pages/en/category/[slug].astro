---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ToolCard from '../../../components/ToolCard.astro';
import { englishCategories, englishTools } from '../../../data/english';
export function getStaticPaths() { return englishCategories.map(category => ({ params: { slug: category.slug }, props: { category } })); }
const { category } = Astro.props;
const items = englishTools.filter(tool => tool.category === category.slug);
---
<BaseLayout language="en" title={`${category.title} — Utilix`} description={category.description}>
  <section class="page-hero container"><a class="breadcrumb" href="/en/">Home</a><span class="breadcrumb-sep">/</span><span class="breadcrumb">Categories</span><span class="eyebrow">CATEGORY</span><h1>{category.title}</h1><p>{category.description}</p></section>
  <section class="section container"><div class="tool-grid">{items.map(tool => <ToolCard tool={tool} />)}</div></section>
</BaseLayout>

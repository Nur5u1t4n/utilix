---
const { tool } = Astro.props;
---
<section class="tool-runner" data-tool={tool.slug}>
  <div class="tool-form" id="tool-form"></div>
  <div class="tool-output" id="tool-output" aria-live="polite">
    <span class="output-placeholder">Результат появится здесь</span>
  </div>
  <div class="tool-actions" id="tool-actions"></div>
</section>
<script>
  import '../scripts/tool-engine';
</script>
